{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-lint.sh", "timeout": 90 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/migration-guard.sh", "timeout": 20 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/env-drift.sh", "timeout": 20 }
        ]
      }
    ]
  }
}
